@model IEnumerable<ISurveyModel>
<ul>
    @foreach (ISurveyModel survey in Model)
    {
        <li>
            <h2>@survey.Title</h2>
            <p>By @survey.Author</p>
            <ul>
                <li><a href="~/survey/@survey.Id">Start Survey</a></li>
                <li><a href="~/staff/search/@survey.Id">See Survey Results</a></li>
            </ul>
        </li>
    }
</ul>