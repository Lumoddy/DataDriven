@{
    string? memberError = ViewData["memberError"] as string;
}

<div>
    <h2>Member Account (Optional)</h2>

    @if (!string.IsNullOrEmpty(memberError))
    {
        <div>
            @memberError
        </div>
    }

    <p>
        You can optionally register or login to link your submission to a member
        account.
    </p>

    <div>
        <button type="button" onclick="showLoginForm()">Login</button>
        <button type="button" onclick="showRegisterForm()">Register</button>
    </div>

    <div id="login-pane">
        <form method="post">
            <input type="hidden" name="action" value="login">
            <input type="hidden" name="submission_index" value="@ViewData["index"]">

            <div>
                <label for="login-phone">Phone Number</label>
                <input type="tel" id="login-phone" name="phone_number"
                    placeholder="e.g., +1234567890" required>
            </div>

            <div>
                <label for="login-password">Password</label>
                <input type="password" id="login-password" name="password" required>
            </div>

            <button type="submit">Login</button>
        </form>
    </div>

    <div id="register-pane">
        <form method="post">
            <input type="hidden" name="action" value="register">
            <input type="hidden" name="submission_index" value="@ViewData["index"]">

            <div>
                <div>
                    <label for="register-first-name">First Name</label>
                    <input type="text" id="register-first-name" name="first_name" required>
                </div>
                <div>
                    <label for="register-last-name">Last Name</label>
                    <input type="text" id="register-last-name" name="last_name" required>
                </div>
            </div>

            <div>
                <label for="register-phone">Phone Number</label>
                <input type="tel" id="register-phone" name="phone_number"
                    placeholder="e.g., +1234567890" required>
            </div>

            <div>
                <label for="register-birth-date">Birth Date</label>
                <input type="date" id="register-birth-date" name="birth_date" required>
            </div>

            <div>
                <label for="register-password">Password</label>
                <input type="password" id="register-password" name="password" required>
            </div>

            <div>
                <label for="register-password-confirm">Confirm Password</label>
                <input type="password" id="register-password-confirm"
                    name="password_confirm" required>
            </div>

            <button type="submit">Register</button>
        </form>
    </div>

    <div>
        <p><small>Your submission has already been saved. This step is optional.</small></p>
    </div>
</div>

<script>
    function showLoginForm() {
        document.getElementById('login-pane').style.display = 'block';
        document.getElementById('register-pane').style.display = 'none';
    }

    function showRegisterForm() {
        document.getElementById('register-pane').style.display = 'block';
        document.getElementById('login-pane').style.display = 'none';
    }

    window.addEventListener('DOMContentLoaded', () => {
        showLoginForm();
    });
</script>
