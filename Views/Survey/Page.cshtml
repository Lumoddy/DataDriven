@using DataDriven.Controllers
@foreach (
    SurveyQuestionViewFields question
    in (IEnumerable<SurveyQuestionViewFields>)ViewData["questions"]!)
{
    <p>@question.Title</p>
    <p>Type = @question.Type</p>
    <ul>
        @foreach (SurveyQuestionShowConditionViewFields constraint in question.ShowConditions)
        {
            <li>
                @constraint.Operator @constraint.Type: (@constraint.ReferencedQuestion, @constraint.TextValue, @constraint.IntegerValue)
            </li>
        }
    </ul>
}