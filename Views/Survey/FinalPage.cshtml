@using DataDriven.Controllers
@using DataDriven.Data
@using System.Diagnostics
@model ISurveyModel
<h1>Completed Survey</h1>
@{
    if (ViewData["index"] is int submissionIndex)
    {
        <p>
            Your answers have been submitted as the @{
                int index = (int)ViewData["index"]!;
                @(index + 1)
                @((index % 10) switch { 0 => "st", 1 => "nd", _ => "th" })
            } submission.
        </p>
    }
    else
    {
        <p>
            You have already submitted.
        </p>
    }
}
<a href="~/">Return to main page</a>